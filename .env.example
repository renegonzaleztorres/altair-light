NODE_ENV="development"
APP_NAME="altair-light"
ACTIVE_SPACE="spaces/kinetic"
PUBLIC_LOCATION="public"
PAGES_LOCATION="pages"
DATA_LOCATION="data"
DATA_FILE="DATA.json"
ENABLE_DATA_WATCH=true

# Optional in-process HTML route cache (disabled by default for compatibility).
ENABLE_ROUTE_CACHE=false
ROUTE_CACHE_MAX_ENTRIES=250
# When both cache and this setting are enabled, the active-space watcher also
# owns DATA.json reloads; ENABLE_DATA_WATCH does not start a second watcher.
ROUTE_CACHE_WATCH=true
ROUTE_CACHE_QUIET_MS=250
ROUTE_CACHE_MAX_BATCH_MS=2000
# Optional metadata safety scan; valid only with the full-space watcher above.
ROUTE_CACHE_RECONCILE=false
ROUTE_CACHE_RECONCILE_MS=30000
ROUTE_CACHE_DEBUG=false

MINIFY=true
DEBUG=true
HOST="127.0.0.1"

# WebSocket Configuration
ENABLE_WEBSOCKET=false
WEBSOCKET_PATH="/ws"
WEBSOCKET_HEARTBEAT_MS=30000
WEBSOCKET_SESSION_TTL_SECS=3600
# Allowed origins: "" (reject all), "*" (allow all - dev only), "same-origin", or comma-separated list
WEBSOCKET_ALLOWED_ORIGINS="same-origin"
